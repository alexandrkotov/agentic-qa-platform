    "kuma_rest": {
      "endpoints": [
        {
          "method": "GET",
          "path": "/api/entry-page",
          "description": "Returns JSON with entry page type configuration; body: {type: 'entryPage', entryPage: null}. Status 200."
        },
        {
          "method": "GET",
          "path": "/api/status-page/heartbeat/default",
          "description": "Returns heartbeat/uptime data for the default status page. Returns empty heartbeatList and uptimeList if no status page is configured. Status 200."
        },
        {
          "method": "GET",
          "path": "/api/badge/1/status",
          "description": "Returns SVG status badge for monitor 1. Shows 'N/A' when monitor has no heartbeat data. Content-Type: image/svg+xml. Status 200."
        },
        {
          "method": "GET",
          "path": "/api/badge/1/uptime",
          "description": "Returns SVG uptime percentage badge for monitor 1. Shows 'N/A' when no data. Content-Type: image/svg+xml. Status 200."
        },
        {
          "method": "GET",
          "path": "/api/badge/1/ping",
          "description": "Returns SVG ping time badge for monitor 1. Shows 'N/A' when no data. Content-Type: image/svg+xml. Status 200."
        },
        {
          "method": "GET",
          "path": "/api/push/testtoken",
          "description": "Push monitor heartbeat endpoint. Returns 404 with {ok: false, msg: 'Monitor not found or not active.'} for invalid/missing push token."
        }
      ]
    }
  },
  "businessRules": [
    "User authentication required to access dashboard, add monitors, and settings pages",
    "Monitors have a heartbeat interval (default 60 seconds) defining how often they are checked",
    "Monitors support retry logic with configurable maxretries and retry_interval",
    "HTTP monitors can filter accepted status codes (default 200-299)",
    "TLS/SSL certificate expiry can be tracked and notified in advance (configurable days)",
    "Domain name expiry can be monitored and notifications sent",
    "Monitors can be organized into groups for hierarchical status pages",
    "Upside Down Mode inverts monitor status (reachable = DOWN)",
    "Max redirects limit configurable (default 10, 0 disables)",
    "HTTP error and success responses can be saved for notification templates",
    "Response body storage size is configurable (default 1024 bytes)",
    "Status pages can be password protected",
    "Maintenance windows can be scheduled with various strategies (single, recurring, cron)",
    "Monitors support various authentication methods: Basic Auth, Bearer Token, OAuth2, NTLM, mTLS",
    "Monitors support proxy configuration",
    "Tags can be assigned to monitors for categorization",
    "2FA authentication is supported but optional",
    "API keys can be created with optional expiration dates",
    "DNS caching via NSCD can be enabled/disabled",
    "Push monitors require a valid push_token to record heartbeats",
    "Group monitors aggregate status from child monitors"
  ],
  "testScenarios": [
    {
      "name": "Create HTTP monitor with valid URL",
      "type": "happy_path",
      "description": "Create an HTTP monitor targeting https://example.com with default settings. Verify monitor appears in dashboard, starts heartbeating, and shows 'Up' status."
    },
    {
      "name": "Create ping monitor",
      "type": "happy_path",
      "description": "Create a Ping monitor targeting localhost. Verify ping checks succeed and uptime is recorded."
    },
    {
      "name": "Login with valid credentials",
      "type": "happy_path",
      "description": "Login with username 'admin' and correct password. Verify redirect to dashboard and session persists."
    },
    {
      "name": "Login with invalid credentials",
      "type": "security",
      "description": "Attempt login with incorrect password. Verify login fails with appropriate error message and no session created."
    },
    {
      "name": "Create monitor with empty URL",
      "type": "edge_case",
      "description": "Try to create an HTTP monitor without providing a URL. Verify validation error prevents creation."
    },
    {
      "name": "Create monitor with invalid URL format",
      "type": "edge_case",
      "description": "Create HTTP monitor with malformed URL (e.g., 'not-a-url'). Verify appropriate error handling."
    },
    {
      "name": "Monitor with zero heartbeat interval",
      "type": "edge_case",
      "description": "Attempt to set heartbeat interval to 0 or negative value. Verify validation prevents this."
    },
    {
      "name": "Push monitor without valid token",
      "type": "edge_case",
      "description": "Call push endpoint /api/push/invalidtoken. Verify 404 response with 'Monitor not found or not active.'"
    },
    {
      "name": "Certificate expiry notification",
      "type": "happy_path",
      "description": "Configure certificate expiry monitoring for an HTTPS site. Verify TLS info is recorded in monitor_tls_info table."
    },
    {
      "name": "Domain expiry tracking",
      "type": "happy_path",
      "description": "Enable domain expiry notification for a monitor. Verify domain_expiry table is populated with expiry date."
    },
    {
      "name": "Access dashboard without authentication",
      "type": "security",
      "description": "Navigate to /dashboard without logging in. Verify redirect to login page."
    },
    {
      "name": "Create API key and test authentication",
      "type": "happy_path",
      "description": "Create an API key in settings. Verify key appears in api_key table and can be used for API authentication."
    },
    {
      "name": "Group monitor with no children",
      "type": "edge_case",
      "description": "Create a Group type monitor with no child monitors. Verify it shows 'Pending' status with 'Group empty' message."
    },
    {
      "name": "Badge endpoint for non-existent monitor",
      "type": "edge_case",
      "description": "Request badge for monitor ID that doesn't exist. Verify appropriate N/A or error response."
    },
    {
      "name": "Monitor with upside down mode",
      "type": "happy_path",
      "description": "Create monitor with Upside Down Mode enabled. Verify that when target is reachable, status shows as 'Down'."
    },
    {
      "name": "Configure maximum redirects",
      "type": "edge_case",
      "description": "Set max redirects to 0 for an HTTP monitor targeting a redirecting URL. Verify redirect is not followed."
    },
    {
      "name": "Status page heartbeat data",
      "type": "happy_path",
      "description": "Create a status page with monitors assigned. Verify /api/status-page/heartbeat/{slug} returns heartbeat data."
    },
    {
      "name": "Two-factor authentication setup",
      "type": "security",
      "description": "Enable 2FA for user account. Verify twofa_status is set to 1 and twofa_secret is populated."
    },
    {
      "name": "Maintenance window effect on monitors",
      "type": "happy_path",
      "description": "Create maintenance window for a monitor. Verify monitor status shows 'Maintenance' during the window."
    },
    {
      "name": "Monitor timeout configuration",
      "type": "edge_case",
      "description": "Set very short timeout (1 second) for slow-responding target. Verify timeout error is recorded in heartbeat."
    }
  ]
}