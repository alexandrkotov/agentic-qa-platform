    "generate:spec": "tsx src/index.ts generate-spec",
    "generate:spec:openai": "tsx src/index.ts generate-spec --provider openai",
    "generate:render": "tsx src/index.ts generate-render",
    "e2e": "tsx src/index.ts e2e",
    "e2e:openai": "tsx src/index.ts e2e --provider openai",
    "apply-fix": "tsx src/index.ts apply-fix",
    "workbench": "tsx src/admin/server.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
