# Just the `docker` CLI binary, not a daemon — this admin image talks to the
# *host's* Docker daemon over a mounted socket (docker-compose.yml's
# admin.volumes), the same "docker-outside-of-docker" pattern the Kafka MCP
# server itself already relies on (descriptor/components/kafka.ts spawns it
# via `docker run --network=host ...`). Multi-stage so the final image
# doesn't carry anything else from this one.
FROM docker:27-cli AS docker-cli

# Debian ("bookworm-slim"), not Alpine: Playwright's browser builds are not
# supported on musl libc (Alpine) — this is a compatibility requirement, not
# a "which distro is smaller" choice. The actual size cost is Chromium
# itself (~400-500MB with its OS deps via --with-deps), which is unavoidable
# either way once the admin UI runs discovery against a descriptor with a
# web-ui component (orderflow.json has one) — see docs/phase5-status.md.
FROM node:22-bookworm-slim
WORKDIR /usr/src/app

COPY --from=docker-cli /usr/local/bin/docker /usr/local/bin/docker

# Installs from the real package.json rather than a hand-picked package list,
# and copies the whole src/ tree rather than a hand-picked file list. The
# admin service's own imports grew substantially once it started running
# Stage 2 spec-generation calls itself (the same Claude/MCP/usage-logging
# machinery the main CLI uses, not just express + zod) — a hand-maintained
# list that silently drifts out of sync with the code's actual imports is
# exactly the failure class this repo's Generate Agent redesign exists to
# eliminate elsewhere; no reason to keep that pattern here.
COPY package.json ./
RUN npm install
RUN npx playwright install --with-deps chromium

COPY src/ src/

EXPOSE 4400
CMD ["npx", "tsx", "src/admin/server.ts"]
