# Just the `docker` CLI binary, not a daemon — this admin image talks to the
# *host's* Docker daemon over a mounted socket (docker-compose.yml's
# admin.volumes), the same "docker-outside-of-docker" pattern the Kafka MCP
# server itself already relies on (descriptor/components/kafka.ts spawns it
# via `docker run --network=host ...`). Multi-stage so the final image
# doesn't carry anything else from this one. Bumped from 27 to 29 to match
# the host's own Engine version (confirmed live: 29.6.2) — the `docker-compose`
# component type (descriptor/components/dockerCompose.ts) deploys arbitrary
# third-party compose files that may use current Compose-spec features like
# `include:`, so an old CLI talking to a new daemon is worth avoiding here.
FROM docker:29-cli AS docker-cli

# The `docker` CLI has no built-in `compose` subcommand of its own — that's
# a separate plugin binary Docker's own CLI-plugin mechanism looks for at
# /usr/local/lib/docker/cli-plugins/docker-compose. docker:29-cli does NOT
# ship it (only the bare `docker` binary — confirmed by inspecting the image
# directly, not assumed), so it's pulled from the plugin's own dedicated
# distribution image instead, which publishes just one file at the image
# root: /docker-compose (verified by extracting docker/compose-bin's own
# layer, not by guessing from its Dockerfile's multi-arch release stage
# naming). Pinned to v5.3.1 to match the host's own installed Compose
# version exactly (confirmed live) — compose is a client-side orchestrator,
# so version skew here isn't fatal, but there's no reason to introduce any.
FROM docker/compose-bin:v5.3.1 AS compose-cli

# `docker compose build` silently falls back to the legacy (non-BuildKit)
# builder whenever it can't find a `buildx` CLI plugin — and that legacy
# builder can't parse BuildKit-only Dockerfile syntax at all. Hit this live:
# nopCommerce's own official Dockerfile opens with
# `FROM --platform=$BUILDPLATFORM ...`, and the fallback legacy build failed
# immediately with "failed to parse platform : \"\" is an invalid OS
# component" — a `build:`-in-compose target (rather than a plain `image:`
# one, which is all every target before nopCommerce happened to use) was
# never exercised until now. Same fix shape as the `docker-compose` plugin
# above: `docker/buildx-bin` publishes just one file at its image root,
# /buildx (verified by extracting the image's own layer, not assumed).
# Pinned to 0.35.0 to match the host's own installed buildx CLI exactly
# (confirmed live via `docker buildx version`) — same reasoning as the
# compose pin above, just carried one plugin further.
FROM docker/buildx-bin:0.35.0 AS buildx-cli

# Debian ("bookworm-slim"), not Alpine: Playwright's browser builds are not
# supported on musl libc (Alpine) — this is a compatibility requirement, not
# a "which distro is smaller" choice. The actual size cost is Chromium
# itself (~400-500MB with its OS deps via --with-deps), which is unavoidable
# either way once the admin UI runs discovery against a descriptor with a
# web-ui component (orderflow.json has one) — see docs/phase5-status.md.
FROM node:22-bookworm-slim
WORKDIR /usr/src/app

COPY --from=docker-cli /usr/local/bin/docker /usr/local/bin/docker
COPY --from=compose-cli /docker-compose /usr/local/lib/docker/cli-plugins/docker-compose
COPY --from=buildx-cli /buildx /usr/local/lib/docker/cli-plugins/docker-buildx
RUN chmod +x /usr/local/lib/docker/cli-plugins/docker-compose /usr/local/lib/docker/cli-plugins/docker-buildx

# git: the docker-compose component type (bootstrap/deployTarget.ts) clones
# an arbitrary target repo (e.g. wger's own deploy manifest repo) before
# handing its compose file to the daemon — bookworm-slim has no git by
# default. ca-certificates alongside it is NOT optional, confirmed the hard
# way: git's own HTTPS backend fails every clone with "server certificate
# verification failed. CAfile: none CRLfile: none" without it — apt doesn't
# pull it in as a dependency of git itself on this slim base, and node:22's
# own base image apparently doesn't ship a trust store either. sqlite3: the
# `sqlite` component type (descriptor/components/sqlite.ts) shells out to
# the real CLI to run read-only queries against a docker-compose-deployed
# target's own .db file — same reasoning as postgres's MCP server, just no
# npm package exists for SQLite that's worth depending on here.
# default-mysql-client (pulls in the real mariadb-client on Debian,
# providing the `mysql` binary): same reasoning again for the `mysql`
# component type (descriptor/components/mysql.ts) — no OFFICIAL
# @modelcontextprotocol/server-mysql package exists (confirmed live,
# npm 404s on it), only unmaintained/unaudited third-party ones not worth
# trusting with real database credentials here.
# --no-install-recommends + the apt-lists cleanup keep this from
# reintroducing the image-bloat concern the Debian-over-Alpine comment
# above already accepts a trade-off on for Chromium.
RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates sqlite3 default-mysql-client \
    && rm -rf /var/lib/apt/lists/*

# Installs from the real package.json rather than a hand-picked package list,
# and copies the whole src/ tree rather than a hand-picked file list. The
# admin service's own imports grew substantially once it started running
# Stage 2 spec-generation calls itself (the same Claude/MCP/usage-logging
# machinery the main CLI uses, not just express + zod) — a hand-maintained
# list that silently drifts out of sync with the code's actual imports is
# exactly the failure class this repo's Generate Agent redesign exists to
# eliminate elsewhere; no reason to keep that pattern here.
COPY package.json ./
RUN npm install
RUN npx playwright install --with-deps chromium

COPY src/ src/

# Container starts as root (default), but only long enough for the
# entrypoint to fix up docker.sock group access and drop to the built-in
# non-root "node" user before the real process ever runs — see
# docker-entrypoint.sh for why this can't just be a Dockerfile USER line.
COPY docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

EXPOSE 4400
ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]
CMD ["npx", "tsx", "src/admin/server.ts"]
