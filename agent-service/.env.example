# Claude provider (primary)
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-4-5

# OpenAI provider (secondary, for comparison)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# Target application — used when running tests directly on the host
# (pnpm test / pnpm e2e), outside Docker.
BACKEND_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173
DATABASE_URL=postgresql://user:pass@localhost:5432/testdb

# Same, but for the workbench CONTAINER's own compose network (service
# names, not localhost) — read by server.ts's BASE_TEST_RUN_ENV for every
# test/E2E run the admin UI triggers. Falls back to these exact values
# (this project's own docker-compose.yml service names) if left unset, so
# omitting this section entirely is safe.
CONTAINER_BACKEND_URL=http://app:3000
CONTAINER_FRONTEND_URL=http://frontend:5173
CONTAINER_DATABASE_URL=postgres://user:pass@db:5432/testdb
CONTAINER_KAFKA_BROKERS=kafka:9092

# Where to save reports
REPORTS_DIR=reports

# GET /agent/status (agentStatus.ts) — the physical ESP32 status monitor's
# backend. All optional:
#  - GITHUB_TOKEN: a token with public_repo (or repo, if this repo goes
#    private) read access, used server-side only to query the GitHub
#    Actions REST API for CI status. Unset works fine against a public repo
#    (unauthenticated, rate-limited to 60 req/hour — the endpoint's own
#    cache is sized around that limit either way).
#  - GITHUB_REPO_OWNER / GITHUB_REPO_NAME: override which repo's Actions
#    runs are reported. Default to this repo (alexandrkotov/agentic-qa-platform).
#  - INFLUXDB_URL: override where the k6 section's InfluxDB queries go.
#    Defaults to http://influxdb:8086 (this project's own compose network) —
#    only needed running server.ts directly on the host instead of in Docker.
#GITHUB_TOKEN=
#GITHUB_REPO_OWNER=alexandrkotov
#GITHUB_REPO_NAME=agentic-qa-platform
#INFLUXDB_URL=http://influxdb:8086
